# EnvKit — Example Environment File
#
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env file — it is in .gitignore.
# These are placeholder values only.

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=mongodb://localhost:27017/example

# Authentication
API_KEY=your-api-key-here
JWT_SECRET=replace-this-with-a-long-random-secret-value

# Feature flags
DEBUG=false
ENABLE_CACHE=true

# External services (optional)
# API_URL=https://api.example.com

# JSON config (optional)
# RATE_LIMIT={"max":100,"windowMs":60000}
